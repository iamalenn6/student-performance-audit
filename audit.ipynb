        "    raise FileNotFoundError\n",
        "df_raw = pd.read_csv(DATA_PATH)\n",
        "df = df_raw.copy()\n",
        "print(f'Размер исходной таблицы: {df.shape[0]} строк × {df.shape[1]} столбцов')\n",
        "display(df.head())\n"
